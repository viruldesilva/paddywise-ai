        {
          "name": "Get Farmer A cycle id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cycles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cycles"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{farmerAToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "let data = pm.response.json();",
                  "const list = Array.isArray(data) ? data : (data.items || data.data || []);",
                  "pm.test(\"Farmer A has at least one cultivation cycle\", () => pm.expect(list.length).to.be.above(0));",
                  "const active = list.find(c => c.status === \"Active\") || list[0];",
                  "if (active) pm.collectionVariables.set(\"cycleId\", active.id);",
                  "console.log(\"Using cycleId\", active && active.id);"
                ]
              }
            }
          ]
        },
