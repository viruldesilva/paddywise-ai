                  "const o = pm.response.json();",
                  "pm.test(\"Owned by Farmer A and has no reports yet\", () => pm.expect(o.reports.length).to.eql(0));",
                  "pm.collectionVariables.set(\"observationId\", o.id);"
                ]
              }
            }
          ]
