    {
      "name": "00 Setup (run first)",
      "item": [
        {
          "name": "Login Farmer A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{farmerAEmail}}\",\n  \"password\": \"{{farmerAPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeds (200)\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().accessToken;",
                  "pm.test(\"Access token returned\", () => pm.expect(t).to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"farmerAToken\", t);"
                ]
              }
            }
