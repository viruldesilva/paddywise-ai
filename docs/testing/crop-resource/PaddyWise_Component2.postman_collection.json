              "mode": "raw",
              "raw": "{\n  \"activityType\": \"Irrigation\",\n  \"date\": \"{{today}}\",\n  \"detailsJson\": \"{\\\"waterLevel\\\": 5, \\\"duration\\\": 2, \\\"source\\\": \\\"Canal\\\"}\"\n}",
