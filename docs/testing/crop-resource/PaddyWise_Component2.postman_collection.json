              }
            ],
            "url": {
              "raw": "{{baseUrl}}/fields/{{fieldId}}/start-cultivation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "fields",
                "{{fieldId}}",
                "start-cultivation"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"varietyId\": {{varietyId}},\n  \"season\": \"Maha\",\n  \"year\": {{year}},\n  \"method\": \"Transplanting\",\n  \"sowingDate\": \"{{today}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.environment.set(\"cycleId\", pm.response.json().id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); pm.environment.set(\"today\", d.toISOString().slice(0, 10)); pm.environment.set(\"year\", d.getFullYear());",
                  "const f = new Date(Date.now() + 3 * 86400000); pm.environment.set(\"futureDate\", f.toISOString().slice(0, 10));"
                ]
              }
            }
          ]
        }
      ]
