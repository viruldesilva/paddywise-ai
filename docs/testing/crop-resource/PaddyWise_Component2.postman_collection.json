{
  "info": {
    "_postman_id": "bdc5d061-5fe6-4e52-b1a5-fe7ff06a1f07",
    "name": "PaddyWise Component 2 - Crop Activity & Resource",
    "description": "Component 2 API checks: crop activity logging (create, list, filter, update, delete, validation, roles), the Resource Analysis Agent, the officer recommendation approval queue and the agent audit trail. Creates its own field and cycle and removes them at the end. Needs the backend on http://localhost:5164 and the farmer/officer logins in the environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Farmer login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{farmerEmail}}\",\n  \"password\": \"{{farmerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response time < 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const j = pm.response.json();",
                  "pm.test(\"Access token issued\", () => pm.expect(j.accessToken).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"farmerToken\", j.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Officer login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{officerEmail}}\",\n  \"password\": \"{{officerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
