              "raw": "{\n  \"name\": \"Postman C2 Field {{$timestamp}}\",\n  \"area\": 1.5,\n  \"soilType\": \"Clay loam\",\n  \"irrigationType\": \"Canal\",\n  \"divisionId\": {{divisionId}}\n}",
