    {
      "name": "4. Cycles and stages",
      "item": [
        {
          "name": "Start cultivation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{farmerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/fields/{{fieldId}}/start-cultivation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "fields",
                "{{fieldId}}",
                "start-cultivation"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"varietyId\": {{varietyId}},\n  \"season\": \"Maha\",\n  \"year\": {{year}},\n  \"method\": \"Transplanting\",\n  \"sowingDate\": \"{{today}}\",\n  \"notes\": \"Created by the Postman collection\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Response time < 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const j = pm.response.json();",
                  "pm.test(\"Cycle is Active at Nursery with a 6-stage timeline\", () => { pm.expect(j.status).to.eql(\"Active\"); pm.expect(j.currentStage).to.eql(\"Nursery\"); pm.expect(j.timeline.length).to.eql(6); });",
                  "pm.environment.set(\"cycleId\", j.id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); pm.environment.set(\"today\", d.toISOString().slice(0, 10)); pm.environment.set(\"year\", d.getFullYear());"
                ]
              }
            }
          ]
        },
