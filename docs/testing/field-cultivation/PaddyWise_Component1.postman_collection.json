        {
          "name": "Poll the plan until it is generated",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{farmerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/plans/{{planId}}",
