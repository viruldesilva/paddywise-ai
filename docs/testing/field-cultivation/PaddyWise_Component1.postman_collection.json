{
  "info": {
    "_postman_id": "e2f1fe00-fb96-4d6c-bd15-b8bf28f877a0",
    "name": "PaddyWise Component 1 - Field & Cultivation",
    "description": "Component 1 API checks: fields, cultivation cycles, growth stages and the Cultivation Planning Agent (request, background generation, officer approval). Run the folders in order; the collection creates its own field and cycle and cleans them up at the end. Needs the backend on http://localhost:5164 and the farmer/officer logins in the environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Farmer login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{farmerEmail}}\",\n  \"password\": \"{{farmerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response time < 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const j = pm.response.json();",
                  "pm.test(\"Access token issued\", () => pm.expect(j.accessToken).to.be.a(\"string\").and.not.empty);",
                  "pm.environment.set(\"farmerToken\", j.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Officer login",
          "request": {
            "method": "POST",
            "header": [
              {
