                "plans",
                "{{planId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const tries = Number(pm.environment.get(\"pollTries\") || 0);",
                  "if (j.status === \"Draft\" && tries < 40) {",
                  "  pm.environment.set(\"pollTries\", tries + 1);",
                  "  setTimeout(() => {}, 3000);",
                  "  postman.setNextRequest(\"Poll the plan until it is generated\");",
                  "} else {",
                  "  pm.environment.set(\"pollTries\", 0);",
                  "  pm.environment.set(\"planStatus\", j.status);",
                  "  pm.test(\"Plan left Draft (generated by the agent)\", () => pm.expect(j.status).to.not.eql(\"Draft\"));",
                  "  pm.test(\"Never auto-approved\", () => pm.expect(j.status).to.be.oneOf([\"PendingOfficerApproval\", \"ValidationFailed\"]));",
                  "  pm.test(\"Planning agent run is logged\", () => pm.expect(j.agentRuns.map(r => r.agentName)).to.include(\"CultivationPlanningAgent\"));",
                  "}"
                ]
              }
            }
          ]
