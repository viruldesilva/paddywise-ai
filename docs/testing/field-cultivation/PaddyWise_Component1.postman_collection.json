                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.environment.get(\"farmerToken\");",
                  "const i = Math.floor(t.length / 2);",
                  "const bad = t.slice(0, i) + (t[i] === \"A\" ? \"B\" : \"A\") + t.slice(i + 1);",
                  "pm.request.headers.upsert({ key: \"Authorization\", value: \"Bearer \" + bad });"
                ]
              }
            }
